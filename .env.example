# Copy to .env and replace these values. Generate a key: openssl rand -hex 32
API_KEY=replace-with-a-random-key-of-at-least-32-characters
DEFAULT_DESTINATION_PATH=/迅雷下载
# An origin reachable from this API container; do not include index.cgi.
XUNLEI_BASE_URL=http://xunlei:2345
# Optional exact browser origins; comma-separated. No wildcards.
CORS_ALLOWED_ORIGINS=
# Optional HTTP Basic authentication on the upstream Xunlei wrapper.
XUNLEI_USERNAME=
XUNLEI_PASSWORD=
# The published tag to use. Pin a version or digest in production.
XUNLEI_API_TAG=latest
